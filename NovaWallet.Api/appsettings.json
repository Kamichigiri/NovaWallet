{
  "ConnectionStrings": { "NovaWalletDb": "Server=localhost;Database=novawallet;Integrated Security=True;Encrypt=False;" },
  "Jwt": {
    "Issuer": "NovaWallet.Dev",
    "Audience": "NovaWallet.Api",
    "SigningKey": "dev-only-signing-key-change-me-to-a-long-random-secret-123456"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "RateLimiting": {
    "TokenLimit": 1,
    "TokensPerPeriod": 1,
    "ReplenishmentPeriodSeconds": 20,
    "QueueLimit": 0
  },
  "AllowedHosts": "*"
}
